# Global
APP_ENV=paper
TRADING_MODE=PAPER_ONLY
LIVE_TRADING_ENABLED=false
TZ=Asia/Shanghai

# Network / internal mesh
TAILSCALE_AUTHKEY=__SET_ON_SERVER__
TAILSCALE_HOSTNAME_LA=ai-quant-la
TAILSCALE_HOSTNAME_TOKYO=ai-quant-tokyo

# LA public hostname. Cloudflare DNS is set to "DNS only" (grey cloud);
# Caddy will auto-issue a Let's Encrypt cert via HTTP-01.
LA_PUBLIC_HOST=quant.example.com

# Tokyo binds its ports ONLY to the Tailscale interface; deploy-tokyo.sh
# discovers this from `tailscale ip -4`, so you do NOT need to set
# TOKYO_TAILSCALE_IP here.
# TOKYO_TAILSCALE_IP=__SET_BY_DEPLOY_SCRIPT__

# API auth (Bearer token, used by every internal worker to talk to control-api).
# Generate once with: openssl rand -hex 32
# Must be IDENTICAL on Tokyo and LA hosts.
API_AUTH_ENABLED=true
API_AUTH_TOKEN=__GENERATE_LONG_RANDOM__

# Comma-separated allowlist of approval operator IDs.
APPROVAL_OPERATORS=alex

# Database
POSTGRES_DB=ai_quant
POSTGRES_USER=ai_quant
POSTGRES_PASSWORD=__SET_STRONG_PASSWORD__
DATABASE_URL=postgresql://ai_quant:__SET_STRONG_PASSWORD__@postgres:5432/ai_quant
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ai_quant
SPRING_DATASOURCE_USERNAME=ai_quant
SPRING_DATASOURCE_PASSWORD=__SET_STRONG_PASSWORD__

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Grafana
GRAFANA_ADMIN_PASSWORD=__GENERATE_GRAFANA_PASSWORD__

# LLM (for the agent's reasoning; agent is currently a deterministic mock,
# so this can be left blank until you wire up real LLM calls).
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=__SET_IN_SERVER_ENV__

# Embedding provider for wiki + experience recall (pgvector).
# - deterministic : SHA-256 derived pseudo-embedding (default, zero cost,
#                   works out of the box, but not semantic).
# - openai_compat : POST {EMBEDDING_BASE_URL}/v1/embeddings; OpenAI-compatible.
#                   Works with DeepSeek / OpenAI / Tongyi / Ollama.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=deepseek-embedding
EMBEDDING_API_KEY=__SET_OR_LEAVE_BLANK__
EMBEDDING_DIM=1536
RECALL_WIKI_LIMIT=5
RECALL_EXPERIENCE_LIMIT=5

# Binance public market data. Do not enable live trading in MVP.
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Hyperliquid
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_INFO_URL=https://api.hyperliquid-testnet.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HYPERLIQUID_COINS=BTC,ETH,SOL
HYPERLIQUID_PRIVATE_KEY=__DO_NOT_COMMIT__

# Polymarket observation only
POLYMARKET_MODE=OBSERVE_ONLY
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYMARKET_RELAYER_API_KEY=__DO_NOT_COMMIT__
POLYMARKET_ADDRESS=__OPTIONAL__

# News and sentiment
NEWSAPI_KEY=__DO_NOT_COMMIT__
FINNHUB_KEY=__DO_NOT_COMMIT__
ALPHA_VANTAGE_KEY=__DO_NOT_COMMIT__
CRYPTOCOMPARE_KEY=__DO_NOT_COMMIT__

# Notifications
TELEGRAM_BOT_TOKEN=__DO_NOT_COMMIT__
TELEGRAM_CHAT_ID=__SET_CHAT_ID__
HERMES_WEBHOOK_URL=__OPTIONAL__
HERMES_WEBHOOK_SECRET=__DO_NOT_COMMIT__

# R2 backups
CLOUDFLARE_R2_ENDPOINT=__R2_ENDPOINT__
CLOUDFLARE_R2_ACCESS_KEY_ID=__DO_NOT_COMMIT__
CLOUDFLARE_R2_SECRET_ACCESS_KEY=__DO_NOT_COMMIT__
CLOUDFLARE_R2_BUCKET=ai-quant-backups

# Risk defaults
ACCOUNT_EQUITY_USD=1000
MIN_AGENT_CONFIDENCE=0.65
MIN_RISK_REWARD=1.5
MAX_TRADE_RISK_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_CONSECUTIVE_LOSSES=3
MAX_LEVERAGE=2
MAX_SYMBOL_POSITION_PCT=0.20
MAX_OPEN_POSITIONS=3
APPROVAL_TTL_MINUTES=10
MAX_ENTRY_DEVIATION_PCT=0.003
MAX_SLIPPAGE_PCT=0.002
