{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-quant/agent-decision.schema.json",
  "title": "AgentDecision",
  "type": "object",
  "required": [
    "symbol",
    "market",
    "direction",
    "entry",
    "stop_loss",
    "take_profit",
    "risk_reward_ratio",
    "confidence",
    "max_position_size",
    "invalidation_condition",
    "reasoning_summary",
    "related_memories",
    "news_sources",
    "sentiment_score",
    "risk_flags"
  ],
  "properties": {
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "market": {"type": "string", "minLength": 1, "maxLength": 64},
    "direction": {"type": "string", "enum": ["LONG", "SHORT", "BUY", "SELL", "OBSERVE", "FLAT", "long", "short", "buy", "sell", "observe", "flat"]},
    "entry": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "min": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0},
        "price": {"type": "number", "exclusiveMinimum": 0}
      },
      "anyOf": [
        {"required": ["min", "max"]},
        {"required": ["price"]}
      ]
    },
    "stop_loss": {"type": "number", "exclusiveMinimum": 0},
    "take_profit": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "risk_reward_ratio": {"type": "number", "minimum": 0.5, "maximum": 20},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "max_position_size": {
      "type": "object",
      "properties": {
        "notional_usd": {"type": "number", "exclusiveMinimum": 0},
        "risk_usd": {"type": "number", "exclusiveMinimum": 0}
      },
      "anyOf": [
        {"required": ["notional_usd"]},
        {"required": ["risk_usd"]}
      ]
    },
    "leverage": {"type": "number", "minimum": 1, "maximum": 5},
    "invalidation_condition": {"type": "string", "minLength": 1},
    "reasoning_summary": {"type": "string", "minLength": 1},
    "related_memories": {"type": "array", "items": {"type": "string"}},
    "news_sources": {"type": "array", "items": {"type": "string"}},
    "sentiment_score": {"type": "number", "minimum": -1, "maximum": 1},
    "risk_flags": {"type": "array", "items": {"type": "string"}}
  }
}
